[Unit]
Description=Call Analysis System (Dispatcher and Dashboard)
After=network.target postgresql.service mysql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/calls/SpeechAn
ExecStart=/usr/bin/python3 /opt/calls/SpeechAn/src/main.py
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=call-analysis

# environment variables if needed
Environment=PYTHONPATH=/opt/calls/SpeechAn:/opt/calls/SpeechAn/src
Environment=OMP_NUM_THREADS=8
Environment=MKL_NUM_THREADS=8

[Install]
WantedBy=multi-user.target
