# PostgreSQL (целевая БД для результатов анализа)
PG_HOST=localhost
PG_PORT=5432
PG_DB=call_analysis
PG_USER=analyzer
PG_PASSWORD=secure_password

# MySQL (исходные метаданные звонков)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=asterisk
MYSQL_USER=readonly
MYSQL_PASSWORD=readonly_password

# Путь к корню архива записей
RECORDS_ROOT=/data/calls

# Настройки параллелизма
NUM_WORKERS=6
OMP_NUM_THREADS=8

# Путь к LLM модели (OpenVINO директория)
LLM_MODEL_PATH=models/qwen2.5-7b-instruct-ov

# Настройки веб-интерфейса
WEB_USER=admin
WEB_PASSWORD=secure_admin_password
NUM_ASR_WORKERS=3
NUM_LLM_WORKERS=2
