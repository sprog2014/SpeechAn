# PostgreSQL (целевая БД для результатов анализа)
PG_HOST=localhost
PG_PORT=5432
PG_DB=call_analysis
PG_USER=analyzer
PG_PASSWORD=secure_password

# MySQL (исходные метаданные звонков)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=asterisk
MYSQL_USER=readonly
MYSQL_PASSWORD=readonly_password

# Путь к корню архива записей
RECORDS_ROOT=/data/calls

# Настройки параллелизма
NUM_WORKERS=10
OMP_NUM_THREADS=8

# Настройки веб-интерфейса
WEB_USER=admin
WEB_PASSWORD=secure_admin_password